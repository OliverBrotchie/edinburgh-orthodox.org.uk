---
import { getCollection, type CollectionEntry } from "astro:content";
import NewsList from "../../components/newslist.astro";
import Layout from "../../layouts/layout.astro";

const posts: CollectionEntry<"news">[] = await getCollection(
    "news",
    ({ data }: CollectionEntry<"news">) => !data.draft,
);
const news = posts
    .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime())
    .map((post) => ({
        title: post.data.title,
        date: post.data.publishedAt,
        href: `/news/${post.id}/`,
    }));
---

<Layout title="News | St Andrew's Orthodox Church">
    <div class="wrap">
        <section class="page-section">
            <h1>News</h1>
            <p class="page-intro">News and announcements from the community.</p>

            <div class="page-col">
                <NewsList items={news} />
            </div>
        </section>
    </div>
</Layout>
