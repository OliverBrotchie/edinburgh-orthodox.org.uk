---
import churchLogo from "../assets/red-logo-church.jpg";

const navLinks = [
    { href: "/churches", label: "Our Churches" },
    { href: "/donations", label: "Donate" },
    { href: "/wishlist", label: "Wishlist" },
    { href: "/clergy", label: "Clergy" },
    { href: "/news", label: "News" },
    { href: "/faq", label: "FAQ" },
];

const additionalLinks = [
    { href: "#", label: "Confessions" },
    { href: "#", label: "Magazine" },
    { href: "/history", label: "History" },
    {
        href: "https://saintandrewsorthodoxchurchschool.org.uk/",
        label: "Orthodox School",
        external: true,
    },
];
---

<header class="site-head">
    <div class="inner">
        <a class="brand" href="/">
            <img src={churchLogo.src} alt="St Andrew's Orthodox Church logo" />
            St Andrew's Orthodox Church
        </a>

        <div class="nav-area">
            <nav class="site-nav" aria-label="Main navigation">
                <ul class="nav-row">
                    {
                        navLinks.map((link) => (
                            <li>
                                <a href={link.href}>{link.label}</a>
                            </li>
                        ))
                    }
                </ul>

                <button
                    class="nav-toggle"
                    aria-label="More links"
                    aria-expanded="false"
                    type="button"
                >
                    <span></span>
                    <span></span>
                    <span></span>
                </button>

                <ul class="more-menu">
                    <button
                        class="drawer-close"
                        aria-label="Close menu"
                        type="button"
                    >
                        &times;
                    </button>

                    {
                        navLinks.map((link) => (
                            <li data-dupe="1">
                                <a href={link.href}>{link.label}</a>
                            </li>
                        ))
                    }

                    {
                        additionalLinks.map((link) => (
                            <li>
                                <a
                                    href={link.href}
                                    target={
                                        link.external ? "_blank" : undefined
                                    }
                                    rel={link.external ? "noopener" : undefined}
                                >
                                    {link.label}
                                </a>
                            </li>
                        ))
                    }
                </ul>
            </nav>
        </div>
    </div>
</header>

<script>
    import { initializeNavigation } from "../scripts/navigation.js";

    initializeNavigation();
</script>
