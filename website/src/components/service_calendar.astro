---
interface Service {
    time: string;
    location: string;
}

interface Day {
    date: string;
    note?: string;
    mark?: string;
    markClass?: string;
    services: Service[];
}

interface Props {
    days: Day[];
}

const { days } = Astro.props;
---

<section class="cal-section">
    <h2>Weekly Services</h2>

    <div class="cal-wrap">
        <div class="cal">
            {
                days.map((day) => (
                    <div class="cal-day">
                        <div class="cal-date">
                            {day.date}

                            {day.note && (
                                <small>
                                    {day.note}

                                    {day.mark && (
                                        <span
                                            class={`mark ${day.markClass ?? ""}`}
                                        >
                                            {day.mark}
                                        </span>
                                    )}
                                </small>
                            )}
                        </div>

                        <div class="cal-body">
                            {day.services.map((service) => (
                                <span class="svc">
                                    {service.time}
                                    <span class="loc">
                                        ({service.location})
                                    </span>
                                </span>
                            ))}
                        </div>
                    </div>
                ))
            }
        </div>

        <p class="muted">
            Edited in Google Calendar. A "copy this week" button produces the
            plain text to post to WhatsApp, Facebook, and email.
        </p>
    </div>
</section>
