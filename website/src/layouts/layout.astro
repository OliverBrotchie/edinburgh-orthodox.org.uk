---
import Header from "../components/header.astro";
import Footer from "../components/footer.astro";
import churchLogo from "../assets/red-logo-church.jpg";
import "../styles/style.css";

interface Props {
    title?: string;
}

const { title = "St Andrew's Orthodox Church" } = Astro.props;
const faviconHref = `${churchLogo.src}?v=2`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <link rel="icon" type="image/jpeg" href={faviconHref} />
        <link rel="shortcut icon" type="image/jpeg" href={faviconHref} />
        <link rel="apple-touch-icon" href={faviconHref} />
        <title>{title}</title>
    </head>

    <body>
        <Header />

        <main>
            <slot />
        </main>

        <Footer />
    </body>
</html>
